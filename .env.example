# Lazarus Keeper Daemon Configuration (Stellar Testnet / Mainnet)

# Stellar secret key for the keeper account (must hold XLM for base transaction fees)
LAZARUS_KEEPER_SECRET=SBZ7T5X23Y7EXAMPLEKEEPERSECRETKEY00000000000000000000000

# Lazarus Indexer REST API URL
LAZARUS_INDEXER_API_URL=https://api.lazarusprotocol.online

# Soroban RPC URL
LAZARUS_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Network Passphrase
LAZARUS_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# On-chain LazarusVault Contract ID
LAZARUS_VAULT_CONTRACT_ID=CCWAH7BVPGYOEBPRFWPZIONBYUCCQH7OARGZLOD6ZV66SOAFBVA2DHD5

# Maximum retention before flushing unredeemed vouchers to vault (seconds)
LAZARUS_BUFFER_FLUSH_INTERVAL=600

# Emergency bypass threshold in ledgers (~2.7 hours)
LAZARUS_EMERGENCY_BYPASS_LEDGERS=2000

# Offline test stub mode (set false for live keeper execution)
LAZARUS_DEV_STUB_MODE=false

